#!/usr/bin/env python3
"""
Sentience POC - SWG Log Generator
Generates simulated Secure Web Gateway logs for testing

Creates Cloudflare-style proxy logs with:
- AI tool traffic (ChatGPT, Claude, Midjourney, etc.)
- Normal web traffic (Google, GitHub, etc.)
- Multiple users over 7-day period
"""

import json
import random
from datetime import datetime, timedelta
from pathlib import Path


# User pool (simulated employees)
USERS = ["alice", "bob", "charlie", "diana", "eve", "frank", "grace", "henry"]

# AI tool domains (mix of licensed and shadow)
AI_DOMAINS = [
    "chat.openai.com",           # ChatGPT - Licensed
    "claude.ai",                 # Claude - Licensed
    "copilot.github.com",        # Copilot - Licensed
    "gemini.google.com",         # Gemini - Shadow
    "midjourney.com",            # Midjourney - Shadow
    "perplexity.ai",             # Perplexity - Shadow
    "huggingface.co",            # HuggingFace - Shadow
    "runwayml.com",              # Runway - Shadow
    "api.openai.com",            # OpenAI API
    "api.anthropic.com"          # Anthropic API
]

# Non-AI domains for realistic traffic mix
NON_AI_DOMAINS = [
    "google.com",
    "github.com",
    "stackoverflow.com",
    "docs.microsoft.com",
    "slack.com",
    "gmail.com",
    "drive.google.com"
]


def generate_log_entry(timestamp):
    """
    Generate a single SWG log entry
    
    Format matches Cloudflare Gateway logs:
    {
        "timestamp": ISO timestamp,
        "user": user identifier,
        "domain": destination domain,
        "method": HTTP method,
        "status": HTTP status code
    }
    
    Args:
        timestamp: datetime for this log entry
        
    Returns:
        dict: Log entry
    """
    user = random.choice(USERS)
    
    # 70% AI traffic, 30% normal traffic
    # This ensures good AI detection data
    if random.random() < 0.7:
        domain = random.choice(AI_DOMAINS)
    else:
        domain = random.choice(NON_AI_DOMAINS)
    
    return {
        "timestamp": timestamp.isoformat(),
        "user": user,
        "domain": domain,
        "method": "GET",
        "status": 200
    }


def generate_logs(num_entries=200, output_file="telemetry/swg_logs.jsonl"):
    """
    Generate simulated SWG logs
    
    Creates:
    - Specified number of log entries
    - Distributed over 7-day period
    - Mix of AI and non-AI traffic
    - Multiple users
    
    Args:
        num_entries: Number of log entries to generate
        output_file: Path to output JSONL file
    """
    print(f"🔄 Generating {num_entries} SWG log entries...")
    
    # Ensure output directory exists
    Path(output_file).parent.mkdir(parents=True, exist_ok=True)
    
    logs = []
    start_time = datetime.utcnow() - timedelta(days=7)
    
    # Generate logs distributed over time
    for i in range(num_entries):
        # Random timestamp within 7-day window
        # Update: Weight 50% of traffic to the last 24h for "24h Velocity" chart
        if i < num_entries // 2:
            # Older logs (7 days to 24h ago)
            seconds_ago = random.randint(24 * 60 * 60, 7 * 24 * 60 * 60)
        else:
            # Recent logs (last 24h)
            seconds_ago = random.randint(0, 24 * 60 * 60)
            
        timestamp = datetime.utcnow() - timedelta(seconds=seconds_ago)
        logs.append(generate_log_entry(timestamp))
    
    # Sort by timestamp (realistic log order)
    logs.sort(key=lambda x: x["timestamp"])
    
    # Write to JSONL file (one JSON object per line)
    with open(output_file, "w") as f:
        for log in logs:
            f.write(json.dumps(log) + "\n")
    
    # Print summary statistics
    ai_logs = [l for l in logs if l["domain"] in AI_DOMAINS]
    unique_ai_domains = set(l["domain"] for l in ai_logs)
    
    print(f"✅ Generated {num_entries} log entries")
    print(f"   📁 Output: {output_file}")
    print(f"   🤖 AI-related logs: {len(ai_logs)} ({len(ai_logs)*100//num_entries}%)")
    print(f"   🌐 Non-AI logs: {len(logs) - len(ai_logs)}")
    print(f"   👥 Unique users: {len(set(l['user'] for l in logs))}")
    print(f"   🔧 Unique AI domains: {len(unique_ai_domains)}")
    print(f"   📅 Time range: {logs[0]['timestamp'][:10]} to {logs[-1]['timestamp'][:10]}")
    print()


if __name__ == "__main__":
    # Generate 200 logs by default
    # Can be customized: generate_logs(500) for more data
    # Generate 500 logs for demo
    generate_logs(500)
    print("✨ Log generation complete!")